# Python cache / compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
config.local.*

# Generated outputs
outputs/
results/
runs/
logs/
wandb/
mlruns/
checkpoints/
backend/data/evaluation_outputs/*
!backend/data/evaluation_outputs/.gitkeep
backend/data/feedback_data/*
!backend/data/feedback_data/.gitkeep

# Raw local datasets and archives
backend/data/datasets/*
!backend/data/datasets/.gitkeep
!backend/data/datasets/README.md
backend/data/archives/*
!backend/data/archives/.gitkeep

# Temporary model saves
*.tmp.h5
*.tmp.keras

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Local archives
*.7z
*.tar
*.tar.gz

# React / Node
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
