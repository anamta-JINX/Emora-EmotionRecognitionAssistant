# Optional path overrides. Relative paths are resolved from the project root.
EMORA_BASE_MODEL_PATH=backend/models/emora_model.h5
EMORA_FEEDBACK_MODEL_PATH=backend/models/feedback_model.keras
EMORA_DNN_PROTOTXT_PATH=backend/resources/face_detector/deploy.prototxt
EMORA_DNN_MODEL_PATH=backend/resources/face_detector/res10_300x300_ssd_iter_140000.caffemodel
EMORA_MAX_UPLOAD_MB=10
FLASK_DEBUG=0

# Keep enabled for instant first prediction (model loads during Flask startup).
EMORA_PRELOAD_MODEL=1
